# Frontend environment (copy to `.env` for local overrides)

# AI opponent: `mock` (in-browser, no backend) or `api` (HTTP backend)
# VITE_AI_PROVIDER=mock

# Remote AI API base URL (production / Capacitor iOS — HTTPS only, no secrets)
# Dev default: `/api` proxied to local Node/KataGo via Vite (see vite.config.ts)
# VITE_AI_API_BASE_URL=https://your-api.example.com

# Optional request timeout in milliseconds (default 30000)
# VITE_AI_TIMEOUT_MS=30000
