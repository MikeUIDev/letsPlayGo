# HTTP port for the AI backend
PORT=3001

# Path to the KataGo binary (not committed to Git)
KATAGO_BINARY_PATH=/path/to/katago

# Path to a KataGo neural network (.bin.gz — not committed to Git)
KATAGO_MODEL_PATH=/path/to/kata1-b18c384nbt-s9993317504-d4316597426.bin.gz

# Path to a KataGo Analysis Engine config file (e.g. analysis_example.cfg)
KATAGO_CONFIG_PATH=/path/to/analysis_example.cfg

# Request timeout for a single AI move (milliseconds)
AI_REQUEST_TIMEOUT_MS=30000

# Timeout while waiting for KataGo to finish loading the model (milliseconds)
KATAGO_STARTUP_TIMEOUT_MS=120000
